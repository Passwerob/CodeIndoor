# DeepSeek credentials — required for the LLM-driven planning / scene-gate steps.
# Copy this file to runtime/.env and fill in your own key. NEVER commit the real .env.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Image model for per-object reference images (furniture_forge / reference_images).
# Any OpenAI-compatible /images/generations endpoint.
IMAGE_API_KEY=
IMAGE_API_BASE=https://us.novaiapi.com/v1
IMAGE_MODEL=gpt-image-2.6

# Optional second image endpoint, tried only when the first one fails
# (relay providers drop their upstream channel without notice).
IMAGE_FALLBACK_API_KEY=
IMAGE_FALLBACK_API_BASE=https://api.chimerahub.org/v1
IMAGE_FALLBACK_MODEL=gpt-image-2.6
